---
import Shell from '../layouts/Shell.astro';
import ProjectGrid from '../components/astro/ProjectGrid.astro';
import { getCollection } from 'astro:content';

const allWork = await getCollection('work');
---

<Shell title="samuel.m" breadcrumb="~/" page="home">
  <div class="home-wrapper">
    <section class="hero">
      <div class="mark-row">
        <span class="mark">slm</span>
        <div class="mark-meta">
          <span class="mark-name">Samuel L. McClanahan</span>
          <span class="mark-loc">San Francisco, CA</span>
        </div>
      </div>
      <h1 class="h1"><span class="gradient">hello!</span></h1>
      <div class="body-block">
        <span class="body-prompt">›</span>
        <p class="body-text">
          I'm a high school junior in San Francisco passionate about AI, cybersecurity, robotics, and hardware. Currently I'm working on making a scalable and low cost plane and drone detection system.<br><br>
          Want to talk about anything? Reach out at porkbuns1964[at]gmail[dot]com
        </p>
      </div>
    </section>

    <section class="posts">
      <div class="posts-head">
        <span class="posts-cmd">$ ls -t ~/work</span>
        <a href="/work" class="posts-all">list view ■</a>
      </div>
      <ProjectGrid posts={allWork} />
    </section>
  </div>

  <style is:global>
    .home-wrapper {
      max-width: 1080px;
      margin: 0 auto;
      padding: 48px 20px 40px;
    }
    .hero { margin-bottom: 56px; max-width: 640px; }
    .mark-row {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 28px;
    }
    .mark {
      width: 36px;
      height: 36px;
      border-radius: 6px;
      background: linear-gradient(135deg, #2a1614 0%, #160c0a 100%);
      border: 1px solid var(--accent-line-strong);
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: "Montserrat", sans-serif;
      font-size: 14px;
      font-weight: 700;
      font-style: italic;
      color: var(--accent-bright);
    }
    .mark-meta { display: flex; flex-direction: column; gap: 2px; }
    .mark-name { font-size: 13px; color: var(--fg-strong); letter-spacing: -0.01em; }
    .mark-loc { font-size: 11px; color: var(--fg-faint); font-family: "0xProto Nerd Font Mono", "0xProto", monospace; }
    .h1 {
      font-family: "Montserrat", sans-serif;
      font-size: 52px;
      font-weight: 700;
      line-height: 1.1;
      letter-spacing: -0.025em;
      color: var(--fg-strong);
      margin: 0 0 24px;
      text-wrap: balance;
    }
    .gradient {
      color: var(--fg-strong);
      -webkit-text-fill-color: var(--fg-strong);
      background: none;
    }
    .body-block {
      display: flex;
      gap: 12px;
      align-items: flex-start;
      max-width: 600px;
    }
    .body-prompt {
      color: var(--accent);
      font-family: "0xProto Nerd Font Mono", "0xProto", monospace;
      font-size: 16px;
      line-height: 1.55;
      margin-top: 1px;
      flex-shrink: 0;
    }
    .body-text {
      font-size: 15.5px;
      line-height: 1.7;
      color: var(--fg-mid);
      margin: 0;
      text-wrap: pretty;
    }
    .posts { margin-bottom: 24px; }
    .posts:last-child { margin-bottom: 0; }
    .posts-head {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      margin-bottom: 20px;
      padding-bottom: 12px;
      border-bottom: 1px solid var(--accent-line);
    }
    .posts-cmd {
      font-family: "0xProto Nerd Font Mono", "0xProto", monospace;
      font-size: 12px;
      color: var(--fg-mid);
    }
    .posts-all {
      background: transparent;
      border: none;
      cursor: pointer;
      font-family: "0xProto Nerd Font Mono", "0xProto", monospace;
      font-size: 11px;
      color: var(--accent-dim);
      text-decoration: none;
      transition: color .12s;
    }
    .posts-all:hover { color: var(--accent-bright); }
    @media (max-width: 640px) {
      .home-wrapper { padding: 32px 16px 24px; }
      .h1 { font-size: 42px; }
    }
  </style>
</Shell>
