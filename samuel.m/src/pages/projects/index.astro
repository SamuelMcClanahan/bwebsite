---
import Shell from '../../layouts/Shell.astro';
import ProjectGrid from '../../components/astro/ProjectGrid.astro';
import { getCollection } from 'astro:content';

const projects = await getCollection('projects');
---

<Shell title="projects · samuel.m" breadcrumb="~/projects" page="home">
  <div class="work-wrapper">
    <header class="work-header">
      <h1 class="work-h1">projects</h1>
      <p class="work-lede">
        <span class="work-prompt">›</span>
        <span>What I've built when I should have been doing homework. Click in for the long version.</span>
      </p>
    </header>

    <div class="cmd-line">
      <span class="cmd">$ ls --tree ~/projects</span>
    </div>

    <ProjectGrid projects={projects} />
  </div>

  <style is:global>
    .work-wrapper {
      max-width: 920px;
      margin: 0 auto;
      padding: 40px 20px 24px;
    }
    .work-header { margin-bottom: 40px; }
    .work-h1 {
      font-family: "Montserrat", sans-serif;
      font-size: 56px;
      font-weight: 700;
      letter-spacing: -0.03em;
      color: var(--fg-strong);
      margin: 0 0 12px;
      line-height: 1;
    }
    .work-lede {
      display: flex;
      gap: 10px;
      align-items: flex-start;
      font-size: 14.5px;
      line-height: 1.55;
      color: var(--fg-dim);
      margin: 0;
      max-width: 580px;
      text-wrap: pretty;
    }
    .work-prompt {
      color: var(--accent);
      font-family: "0xProto Nerd Font Mono", "0xProto", monospace;
      font-size: 14px;
      margin-top: 1px;
      flex-shrink: 0;
    }
    .cmd-line {
      display: flex;
      justify-content: space-between;
      padding: 0 0 12px;
      background: transparent;
      border: none;
      border-bottom: 1px solid var(--accent-line);
      border-radius: 0;
      margin-bottom: 24px;
      font-family: "0xProto Nerd Font Mono", "0xProto", monospace;
      font-size: 12px;
    }
    .cmd { color: var(--fg-mid); }
  </style>
</Shell>
