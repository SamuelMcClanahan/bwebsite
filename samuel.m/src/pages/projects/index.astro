---
import Shell from '../../layouts/Shell.astro';
import { getCollection } from 'astro:content';

const projects = await getCollection('projects');
---

<Shell title="projects · samuel.m" breadcrumb="~/projects" page="work">
  <div class="work-wrapper">
    <header class="work-header">
      <h1 class="work-h1">projects</h1>
      <p class="work-lede">
        <span class="work-prompt">›</span>
        <span>What I've built when I should have been doing homework. Click in for the long version.</span>
      </p>
    </header>

    <div class="cmd-line">
      <span class="cmd">$ ls --tree ~/projects</span>
    </div>

    <div class="grid">
      {projects.map((p) => (
        <a href={`/projects/${p.id.replace(/\.md$/, '')}/`} class="card">
          <h3 class="card-title">{p.data.name}</h3>
          <div class="card-tag">{p.data.tag}</div>
          <p class="card-desc">{p.data.summary}</p>
          <div class="card-foot">
            <span class="card-open">open →</span>
          </div>
        </a>
      ))}
    </div>
  </div>

  <style is:global>
    .work-wrapper {
      max-width: 920px;
      margin: 0 auto;
      padding: 40px 0 24px;
    }
    .work-header { margin-bottom: 40px; }
    .work-h1 {
      font-family: "Montserrat", sans-serif;
      font-size: 56px;
      font-weight: 700;
      letter-spacing: -0.03em;
      color: var(--fg-strong);
      margin: 0 0 12px;
      line-height: 1;
    }
    .work-lede {
      display: flex;
      gap: 10px;
      align-items: flex-start;
      font-size: 14.5px;
      line-height: 1.55;
      color: var(--fg-dim);
      margin: 0;
      max-width: 580px;
      text-wrap: pretty;
    }
    .work-prompt {
      color: var(--accent);
      font-family: "0xProto Nerd Font Mono", "0xProto", monospace;
      font-size: 14px;
      margin-top: 1px;
      flex-shrink: 0;
    }
    .cmd-line {
      display: flex;
      justify-content: space-between;
      padding: 0 0 12px;
      background: transparent;
      border: none;
      border-bottom: 1px solid var(--accent-line);
      border-radius: 0;
      margin-bottom: 24px;
      font-family: "0xProto Nerd Font Mono", "0xProto", monospace;
      font-size: 12px;
    }
    .cmd { color: var(--fg-mid); }
    .grid {
      display: flex;
      flex-direction: column;
      gap: 0;
    }
    .card {
      display: flex;
      flex-direction: column;
      gap: 8px;
      padding: 18px 0;
      text-align: left;
      background: transparent;
      border: none;
      border-bottom: 1px solid var(--accent-line);
      border-radius: 0;
      cursor: pointer;
      transition: none;
      text-decoration: none;
      color: inherit;
      outline: none;
      -webkit-appearance: none;
    }
    .card:hover .card-title { color: var(--accent-bright); }
    .card-title {
      font-family: "Montserrat", sans-serif;
      font-size: 24px;
      font-weight: 600;
      color: var(--fg-strong);
      margin: 6px 0 0;
      letter-spacing: -0.015em;
    }
    .card-tag {
      font-family: "0xProto Nerd Font Mono", "0xProto", monospace;
      font-size: 11px;
      color: var(--accent-dim);
    }
    .card-desc {
      font-size: 13.5px;
      color: var(--fg-dim);
      margin: 4px 0 auto;
      line-height: 1.55;
      text-wrap: pretty;
    }
    .card-foot {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding-top: 10px;
      border-top: 1px dashed var(--accent-line);
      font-family: "0xProto Nerd Font Mono", "0xProto", monospace;
      font-size: 11px;
      color: var(--fg-faint);
      margin-top: 12px;
    }
    .card-open { color: var(--accent-bright); }
  </style>
</Shell>
