---
import type { CollectionEntry } from 'astro:content';
import ProjectImage from './ProjectImage.astro';

interface Props {
  posts: CollectionEntry<'work'>[];
}

const { posts } = Astro.props;
const sorted = [...posts].sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<div class="pgrid">
  {sorted.map((p) => {
    const slug = p.id.replace(/\.md$/, '');
    return (
      <a href={`/work/${slug}/`} class="pcard">
        <ProjectImage src={p.data.image} alt={p.data.title} label={`~/work/${slug}`} ratio="3 / 2" />
        <div class="pcard-body">
          <h3 class="pcard-title">{p.data.title}</h3>
          <p class="pcard-desc">{p.data.excerpt}</p>
          <div class="pcard-meta">
            <span>{p.data.date.toISOString().split('T')[0]}<span class="pcard-dot">·</span></span>
            <span class="pcard-tag">{p.data.tags.join(' · ')}</span>
          </div>
          <div class="pcard-foot">
            <span class="pcard-open">read more →</span>
          </div>
        </div>
      </a>
    );
  })}
</div>

<style>
  .pgrid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }
  .pcard {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--accent-line);
    border-radius: 6px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: border-color .12s;
  }
  .pcard :global(.pimg) {
    border: none;
    border-bottom: 1px solid var(--accent-line);
    border-radius: 0;
  }
  .pcard:hover { border-color: var(--accent-line-strong); }
  .pcard:hover :global(.pimg) { filter: brightness(1.08); }
  .pcard:hover .pcard-title,
  .pcard:hover .pcard-open { color: var(--accent-bright); }
  .pcard-body {
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex: 1;
    padding: 16px 18px 14px;
  }
  .pcard-title {
    font-family: "Montserrat", sans-serif;
    font-size: 18px;
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.25;
    color: var(--fg-strong);
    margin: 0;
    transition: color .12s;
  }
  .pcard-desc {
    font-size: 13.5px;
    line-height: 1.55;
    color: var(--fg-dim);
    margin: 0;
    text-wrap: pretty;
  }
  .pcard-meta {
    font-family: "0xProto Nerd Font Mono", "0xProto", monospace;
    font-size: 11px;
    color: var(--fg-faint);
  }
  .pcard-dot { color: var(--fg-ghost); margin: 0 8px; }
  .pcard-tag { color: var(--accent-dim); }
  .pcard-foot {
    margin-top: auto;
    padding-top: 10px;
    border-top: 1px dashed var(--accent-line);
    font-family: "0xProto Nerd Font Mono", "0xProto", monospace;
    font-size: 11px;
  }
  .pcard-open {
    color: var(--fg-mid);
    transition: color .12s;
  }
  @media (max-width: 900px) {
    .pgrid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 600px) {
    .pgrid { grid-template-columns: 1fr; }
  }
</style>
