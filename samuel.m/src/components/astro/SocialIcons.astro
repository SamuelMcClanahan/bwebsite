<style>
  .socials {
    display: flex;
    gap: 14px;
  }
  .social {
    color: var(--fg-faint);
    display: flex;
    transition: color .15s;
    text-decoration: none;
  }
  .social:hover {
    color: var(--accent-bright);
  }
</style>
