---
interface Props {
  src?: string;
  alt: string;
  label: string;
  ratio?: string;
}

const { src, alt, label, ratio = '16 / 10' } = Astro.props;
const imgStyle = ratio === 'auto' ? undefined : `aspect-ratio: ${ratio}`;
const boxStyle = `aspect-ratio: ${ratio === 'auto' ? '16 / 10' : ratio}`;
---

{src ? (
  <img class="pimg" src={src} alt={alt} loading="lazy" decoding="async" style={imgStyle} />
) : (
  <div class="pimg pimg-empty" role="img" aria-label={alt} style={boxStyle}>
    <span class="pimg-label">{label}</span>
  </div>
)}

<style>
  .pimg {
    display: block;
    width: 100%;
    object-fit: cover;
    border: 1px solid var(--accent-line);
    border-radius: 6px;
    background: var(--surface);
    transition: border-color .12s, filter .12s;
  }
  .pimg-empty {
    display: flex;
    align-items: center;
    justify-content: center;
    background:
      radial-gradient(circle at 85% 15%, var(--wash-1) 0%, transparent 55%),
      radial-gradient(var(--accent-line-strong) 1px, transparent 1px) 0 0 / 14px 14px,
      var(--surface);
  }
  .pimg-label {
    font-family: "0xProto Nerd Font Mono", "0xProto", monospace;
    font-size: 12px;
    color: var(--fg-dim);
  }
</style>
