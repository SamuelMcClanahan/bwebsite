---

<section class="stack">
  <div class="stack-head">
    <span class="stack-cmd">$ ls ~/stack</span>
  </div>
  <div class="stack-grid">
    {groups.map((g) => (
      <div class="stack-group">
        <span class="stack-group-name">{g.name}/</span>
        <ul class="stack-list">
          {g.items.map((it) => (
            <li class="stack-item">
              <span class="stack-badge" aria-hidden="true">
                {it.path ? (
                  <svg viewBox="0 0 24 24" width="13" height="13" fill="currentColor"><path d={it.path} /></svg>
                ) : (
                  <span class="stack-letters">{it.text}</span>
                )}
              </span>
              <span class="stack-label">{it.label}</span>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</section>

<style>
  .stack { margin-top: 48px; }
  .stack-head {
    margin-bottom: 20px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--accent-line);
  }
  .stack-cmd {
    font-family: "0xProto Nerd Font Mono", "0xProto", monospace;
    font-size: 12px;
    color: var(--fg-mid);
  }
  .stack-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  .stack-group-name {
    display: block;
    font-family: "0xProto Nerd Font Mono", "0xProto", monospace;
    font-size: 11px;
    color: var(--accent-dim);
    margin-bottom: 12px;
  }
  .stack-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .stack-item {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .stack-badge {
    width: 24px;
    height: 24px;
    flex-shrink: 0;
    border-radius: 5px;
    border: 1px solid var(--accent-line-strong);
    background: var(--surface);
    color: var(--fg-dim);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: color .12s, border-color .12s;
  }
  .stack-letters {
    font-family: "Montserrat", sans-serif;
    font-size: 9px;
    font-weight: 700;
    font-style: italic;
    letter-spacing: -0.02em;
    line-height: 1;
  }
  .stack-label {
    font-size: 14px;
    color: var(--fg-strong);
    letter-spacing: -0.005em;
    font-family: "Avenir Next", Avenir, "Montserrat", sans-serif;
    transition: color .12s;
  }
  .stack-item:hover .stack-badge { color: var(--accent-bright); border-color: var(--accent-dim); }
  .stack-item:hover .stack-label { color: var(--accent-bright); }
  @media (max-width: 640px) {
    .stack { margin-top: 36px; }
    .stack-grid { grid-template-columns: repeat(2, 1fr); gap: 24px 16px; }
  }
</style>
