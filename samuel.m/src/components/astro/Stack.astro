<section class="stack">
  <div class="stack-head">
    <span class="stack-cmd">$ ls ~/stack</span>
  </div>
  <div class="stack-grid">
    {groups.map((g) => (
      <div class="stack-group">
        <span class="stack-group-name">{g.name}/</span>
        <ul class="stack-list">
          {g.items.map((it) => (
            <li class="stack-item">
              <span class="stack-badge" aria-hidden="true">
                {'path' in it ? (
                  <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor"><path d={it.path} /></svg>
                ) : (
                  <svg viewBox={it.vb} width="14" height="14">
                    <defs>
                      <mask id={`stack-${it.id}`} maskUnits="userSpaceOnUse" x="-100000" y="-100000" width="200000" height="200000" set:html={it.mask} />
                    </defs>
                    <rect x="-100000" y="-100000" width="200000" height="200000" fill="currentColor" mask={`url(#stack-${it.id})`} />
                  </svg>
                )}
              </span>
              <span class="stack-label">{it.label}</span>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</section>

<style>
  .stack { margin-top: 48px; }
  .stack-head {
    margin-bottom: 20px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--accent-line);
